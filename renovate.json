{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>catenahq/renovate-config"],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm dev-deps (minor+patch)",
      "automerge": true
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm runtime (minor+patch)",
      "automerge": true
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "TypeScript 7 (native port) is unsupported by the astro toolchain: @astrojs/check + @volar/kit peer-require typescript ^5||^6, so Renovate cannot even produce a v7 lockfile (npm ci EUSAGE on the desynced branch). Re-enable when @astrojs/check ships a ^7 peer range.",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@catenahq/contracts"],
      "enabled": false
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "docker",
      "automerge": true
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["major"],
      "groupName": "docker (major)",
      "automerge": false
    }
  ],
  "ignorePaths": ["**/node_modules/**"]
}
