# apps/docs -- standalone .gitignore.
#
# Duplicated from the relevant patterns in the catena monorepo root
# .gitignore so the folder ships standalone after
# `git subtree split --prefix=apps/docs`. The monorepo's own root
# .gitignore still applies in the monorepo. Keep both in sync.

# Node + Astro/Starlight build artifacts.
node_modules/
dist/
.astro/
*.tsbuildinfo

# Brand assets are synced into src/styles/brand/ at prebuild time
# from ../../packages/tools/brand/ in the monorepo, or from
# ./tools/brand/ once vendored at split time (see repo-split-runbook).
src/styles/brand/

# Rendered per-client wiki output: regenerated by the infrastructure
# role on every converge. Operator-side, never committed.
wiki/build/

# Local env files (Astro convention).
.env
.env.local
.env.*.local

# Editor and OS noise.
.DS_Store
.idea/
.vscode/
