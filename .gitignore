# catenahq/docs -- standalone .gitignore.

# Node + Astro/Starlight build artifacts.
node_modules/
dist/
.astro/
*.tsbuildinfo

# Rendered per-client wiki output: regenerated by the infrastructure
# role on every converge. Operator-side, never committed.
wiki/build/

# Local env files (Astro convention).
.env
.env.local
.env.*.local

# Editor and OS noise.
.DS_Store
.idea/
.vscode/

# token-savior MCP per-project index cache. Machine-local; regenerated
# on every reindex.
.token-savior-cache.json
