---
// Header brand override for Starlight.
//
// Renders three elements on the Starlight header row, all peers:
//   1. The catena logo (from @catenahq/contracts).
//   2. The "catena docs" wordmark in Conthrax (also from contracts).
//   3. A "catena.run" link out to the marketing site, treated as a
//      full-fledged header member rather than a small breadcrumb.
//
// The logo + wordmark together link to the docs home; the
// catena.run pill (the website's btn-secondary, from the shared brand
// theme) is a sibling link to the marketing root in the matching locale.

import { Image } from "astro:assets";
import logo from "@catenahq/contracts/brand/assets/logo.svg";

const lang = Astro.locals.starlightRoute.locale ?? "en";
const docsHomeHref = lang === "fr" ? "/fr/" : "/en/";
const siteHomeHref = lang === "fr" ? "https://catena.run/fr/" : "https://catena.run/en/";
const siteHomeAria = lang === "fr" ? "Aller à catena.run" : "Go to catena.run";
---
<div class="flex flex-wrap items-center gap-3 min-h-10">
  <a class="inline-flex items-center gap-2 no-underline text-(--sl-color-text)" href={docsHomeHref} aria-label="catena docs">
    <Image src={logo} alt="" class="block w-7 h-7 flex-none" loading="eager" />
    <span class="font-wordmark font-semibold text-xl lowercase leading-none whitespace-nowrap">catena docs</span>
  </a>
  <a class="btn-secondary py-1.5 px-3.5 md:px-3.5 text-sm gap-1 no-underline whitespace-nowrap" href={siteHomeHref} aria-label={siteHomeAria}>
    <svg class="block flex-none" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M10 3 5 8l5 5"
      />
    </svg>
    <span>catena.run</span>
  </a>
</div>
