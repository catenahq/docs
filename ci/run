#!/usr/bin/env bash
# Runs one check of this repository by its name in .github/checks.yml, the same
# in CI and on a workstation: bash ci/run <name>.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

case "${1:-}" in
  site)
    npm ci
    npm run check:versions
    npm run check
    npm run build
    ;;
  *)
    echo "ci/run: unknown check '${1:-}' (checks: site)" >&2
    exit 2
    ;;
esac
