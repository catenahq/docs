# {{ ansible_managed }}
site_name: "{{ cloudflare_zone }} — VPS docs"
site_description: "Operator-provisioned wiki for the stack on {{ inventory_hostname }}."
site_url: "https://{{ vps_docs_hostname }}/"

# Content sources resolved relative to this file (mkdocs.yml sits in the
# build dir alongside docs/ which Ansible populates).
docs_dir: docs
site_dir: site

theme:
  name: material
  language: "{{ catena_default_language | default('en') }}"
  features:
    - content.code.copy
    - navigation.indexes
    # navigation.instant intentionally absent — mkdocs-static-i18n's
    # language switcher needs full page loads to context-switch locales,
    # and mixing the two triggers a strict-mode build warning. Perf loss
    # is negligible for a client docs site of ~7 pages.
    - navigation.sections
    - navigation.tabs
    - search.highlight
    - search.suggest
    - toc.follow
  palette:
    - scheme: default
      primary: slate
      toggle:
        icon: material/weather-sunny
        name: Switch to dark mode
    - scheme: slate
      primary: slate
      toggle:
        icon: material/weather-night
        name: Switch to light mode

# Minimal plugin list — built-in search + mkdocs-static-i18n (pinned in
# pyproject.toml dev deps). i18n serves the default locale at the site
# root and alternates under /<locale>/. Suffix layout: default files are
# plain `index.md` / `how-to-*.md`; French overrides are `*.fr.md`.
# Missing translations fall back to the default locale automatically, so
# operator can ship partial FR trees without breaking nav.
plugins:
  - search
  - i18n:
      docs_structure: suffix
      fallback_to_default: true
      languages:
        - locale: en
          default: true
          name: English
          build: true
        - locale: fr
          name: Français
          build: true
          nav_translations:
            Overview: Aperçu
            Understanding: Comprendre
            Reference: Référence
            How-to: Guides pratiques
            What changed on your VPS: Ce qui a changé sur votre VPS
            How this stack works: Comment fonctionne cette pile
            Files you should not touch: Fichiers à ne pas modifier
            Where your data lives: Où sont vos données
            How big a VPS do I need: "Quel VPS me faut-il"
            Add / remove users: Ajouter / retirer des utilisateurs
            "Deploy apps (per-department access)": "Déployer des applications (accès par département)"
            "Pre-configured apps": "Applications pré-configurées"
            Catalog: Catalogue
            What you can do yourself: Ce que vous pouvez faire vous-même
            Disaster planning: "Planification en cas de sinistre"
            "Prevention: what to set up so recovery is possible": "Prévention : ce qu'il faut mettre en place pour que la récupération soit possible"
            "Recovery: what to do when things go wrong": "Récupération : que faire quand ça tourne mal"
            Add a second backup bucket: "Ajouter un second compartiment de sauvegarde"
            "I deleted something — how do I get it back?": "J'ai supprimé quelque chose — comment le récupérer ?"
            Restore to a fresh VPS (without the operator): "Restaurer sur un nouveau VPS (sans l'opérateur)"

markdown_extensions:
  - admonition
  - attr_list
  - def_list
  - footnotes
  - pymdownx.details
  - pymdownx.highlight:
      anchor_linenums: true
  - pymdownx.inlinehilite
  # Material for MkDocs auto-loads Mermaid.js when it sees this custom
  # fence — renders ```mermaid blocks as SVG diagrams client-side. Used
  # on how-this-stack-works.md; no extra plugin install needed.
  - pymdownx.superfences:
      custom_fences:
        - name: mermaid
          class: mermaid
          format: !!python/name:pymdownx.superfences.fence_code_format
  - pymdownx.tabbed:
      alternate_style: true
  - tables
  - toc:
      permalink: true

# Navigation — keep in sync with apps/docs/wiki/src/ contents. Extras accrete
# here as new pages land.
#
# Grouped into top-level sections so `navigation.tabs` renders a
# tidy horizontal bar (Overview / Understanding / Reference / How-to)
# instead of one tab per page. Flat-list nav overflowed the header
# on narrow widths + in French where labels are longer. Sections keep
# the tab count down to 4 regardless of how many pages we add, with
# the dropdown revealing children on hover/click.
nav:
  - Overview: index.md
  - Understanding:
      - How this stack works: how-this-stack-works.md
      - What changed on your VPS: what-changed.md
  - Reference:
      - Files you should not touch: do-not-touch.md
      - Where your data lives: where-is-my-data.md
      - How big a VPS do I need: sizing.md
  - How-to:
      - Add / remove users: how-to-add-users.md
      - Deploy apps (per-department access): how-to-deploy-apps.md
      - Pre-configured apps:
          - Catalog: catalog/index.md
          - Nextcloud: catalog/nextcloud-s3-oidc.md
          - OnlyOffice: catalog/onlyoffice.md
          - Rocket.Chat: catalog/rocketchat-oidc.md
          - DocuSeal: catalog/docuseal.md
          - Documenso (deprecated): catalog/documenso.md
          - Outline: catalog/outline.md
          - EspoCRM: catalog/espocrm.md
          - Twenty: catalog/twenty.md
          - Plane: catalog/plane.md
          - Cal.com: catalog/cal-com.md
          - Zammad: catalog/zammad.md
          - Chatwoot: catalog/chatwoot.md
          - WordPress: catalog/wordpress.md
          - n8n: catalog/n8n.md
          - ERPNext: catalog/erpnext.md
          - Actual Budget: catalog/actualbudget.md
          - Postiz: catalog/postiz.md
      - What you can do yourself: self-service.md
      - Disaster planning:
          - "Prevention: what to set up so recovery is possible": disaster-prevention.md
          - Add a second backup bucket: how-to-add-second-backup-bucket.md
          - "Recovery: what to do when things go wrong": disaster-recovery.md
          - "I deleted something — how do I get it back?": how-to-restore-one-app.md
          - Restore to a fresh VPS (without the operator): self-restore.md

extra:
  generator: false
  inventory_hostname: "{{ inventory_hostname }}"
  cloudflare_zone: "{{ cloudflare_zone }}"
  catena_version: "{{ catena_version | default('unknown') }}"
  catena_version_date: "{{ catena_version_date | default('') }}"

# Material renders `copyright` as left-aligned footer text. Used here to
# surface the exact catena commit that produced this site so an issue
# report traces back to a specific converge. Kept generic — no client name,
# no "© <company>" claim.
copyright: >-
  catena {{ catena_version | default('unknown') }}
  · converged {{ catena_version_date | default('(date unknown)') }}
